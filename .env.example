# Sao chép file này thành .env rồi điền giá trị thật. File .env KHÔNG được đưa lên GitHub.

# --- Google OAuth (dùng cho đăng nhập Google / quyền Google Drive của từng Giám đốc) ---
# Lấy tại Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Chỉ dùng phía máy chủ (Cloud Functions / Apps Script). Tuyệt đối không nhúng vào file HTML.
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Quản trị ---
# Email Google của Giám đốc Vùng (super admin) – người có toàn quyền trên mọi chi nhánh
SUPER_ADMIN_EMAIL=ten-ban@gmail.com

# --- Firebase (để build/deploy) ---
FIREBASE_PROJECT_ID=so-cskh
